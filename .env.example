# These are configuration values, not credentials.
# Copy to .env and adjust as needed. Never commit .env or cloud credentials.

WINDOWS_VERSION=11
WINDOWS_RAM_SIZE=4G
WINDOWS_CPU_CORES=2
WINDOWS_DISK_SIZE=64G

# Optional Google Cloud Storage backup destination.
# Create/configure a bucket yourself; Cloud Storage may incur charges.
# Example: BACKUP_BUCKET=my-unique-bucket
BACKUP_BUCKET=
BACKUP_PREFIX=space-vm/windows
